{
  "meta": {
    "name": "Bowtie conversion benchmarks by ACV band",
    "source": "Recreated from the Bowtie Standard (Winning by Design) benchmark bands",
    "unit_note": "All CR values are percentages unless stated otherwise. sales_cycle is in days.",
    "null_note": "A null value means no published benchmark exists for that band. Score it as 'neutral', never as 'ahead' or 'behind'."
  },
  "acv_bands": [
    { "index": 0, "label": "<$1k",       "acv_min": 0,      "acv_max": 999 },
    { "index": 1, "label": "$1k-$5k",    "acv_min": 1000,   "acv_max": 4999 },
    { "index": 2, "label": "$5k-$15k",   "acv_min": 5000,   "acv_max": 14999 },
    { "index": 3, "label": "$15k-$50k",  "acv_min": 15000,  "acv_max": 49999 },
    { "index": 4, "label": "$50k-$150k", "acv_min": 50000,  "acv_max": 149999 },
    { "index": 5, "label": "$150k+",     "acv_min": 150000, "acv_max": null }
  ],
  "band_selection": "Annualize the median Closed Won deal amount, then pick the band whose [acv_min, acv_max] range contains it. If ACV is unknown or unparseable, default to band index 3 and say so in the scorecard.",
  "benchmarks": {
    "CR1": {
      "label": "Prospect to MQL",
      "unit": "percent",
      "higher_is_better": true,
      "values_by_band": [5, 10, 15, 20, 30, null]
    },
    "CR2": {
      "label": "MQL to SQL",
      "unit": "percent",
      "higher_is_better": true,
      "values_by_band": [15, 20, 20, 25, 25, null]
    },
    "CR3": {
      "label": "Qualification / handoff (SQL to accepted opportunity)",
      "unit": "percent",
      "higher_is_better": true,
      "values_by_band": [80, 85, 90, 95, 95, 100]
    },
    "CR4": {
      "label": "Win rate (qualified opportunity to Closed Won)",
      "unit": "percent",
      "higher_is_better": true,
      "values_by_band": [15, 17, 20, 25, 30, 35]
    },
    "CR5": {
      "label": "Median discount",
      "unit": "percent",
      "higher_is_better": false,
      "values_by_band": [5, 8, 10, 12, 12, 15]
    },
    "CR6": {
      "label": "Onboarding retained (Closed Won to live / first impact)",
      "unit": "percent",
      "higher_is_better": true,
      "values_by_band": [90, 92, 93, 94, 98, 99]
    },
    "CR7": {
      "label": "Gross revenue retention",
      "unit": "percent",
      "higher_is_better": true,
      "values_by_band": [80, 83, 87, 90, 92, 95]
    },
    "CR8": {
      "label": "Expansion rate",
      "unit": "percent",
      "higher_is_better": true,
      "values_by_band": [10, 15, 20, 22, 25, 30]
    },
    "sales_cycle": {
      "label": "Sales cycle",
      "unit": "days",
      "higher_is_better": false,
      "ranges_by_band": ["<10", "10-20", "30-60", "60-90", "90-180", "180+"],
      "comparison_values_by_band": [10, 15, 45, 75, 135, 180],
      "note": "Compare the client's median days from opportunity creation to Closed Won against comparison_values_by_band (range midpoint, or the bound for open-ended ranges)."
    }
  },
  "band_independent_medians": {
    "lead_to_opportunity": {
      "label": "Lead to Opportunity",
      "unit": "percent",
      "higher_is_better": true,
      "value": 8
    },
    "opportunity_to_close": {
      "label": "Opportunity to Close",
      "unit": "percent",
      "higher_is_better": true,
      "value": 16
    },
    "net_revenue_retention": {
      "label": "Net revenue retention",
      "unit": "percent",
      "higher_is_better": true,
      "value": 102
    }
  },
  "scoring_rule": {
    "higher_is_better": {
      "ahead": "value >= benchmark",
      "near": "value >= 0.8 * benchmark",
      "behind": "value < 0.8 * benchmark"
    },
    "lower_is_better": {
      "ahead": "value <= benchmark",
      "near": "value <= 1.25 * benchmark",
      "behind": "value > 1.25 * benchmark"
    },
    "neutral": "benchmark is null or value is not computable"
  }
}
